# ============================================================
# INFLUENCER 3D POWERHOUSE - Variables de Entorno
# ============================================================
# Copia este archivo como .env y llena los valores:
#   cp .env.example .env
#   nano .env
# ============================================================

# --- DOMINIO ---
# Tu dominio principal (los servicios se acceden como subdominio.DOMAIN)
DOMAIN=tudominio.com
ACME_EMAIL=tu@email.com

# --- BASE DE DATOS ---
PG_USER=influencer
PG_PASSWORD=CAMBIA_ESTO_password_seguro_123

# --- MINIO (Almacenamiento de Videos) ---
MINIO_ACCESS_KEY=minio_admin
MINIO_SECRET_KEY=CAMBIA_ESTO_minio_secret_456

# --- N8N (Automatizacion) ---
N8N_USER=admin
N8N_PASSWORD=CAMBIA_ESTO_n8n_password_789

# --- GRAFANA ---
GRAFANA_USER=admin
GRAFANA_PASSWORD=CAMBIA_ESTO_grafana_password

# --- TRAEFIK DASHBOARD ---
# Generar con: htpasswd -nB admin
# Formato: usuario:hash_bcrypt
TRAEFIK_DASHBOARD_AUTH=admin:$$2y$$10$$hash_aqui

# --- IA: OLLAMA (Local, gratuito) ---
# No necesita API key, corre localmente
# Modelo por defecto: qwen2.5:7b

# --- IA: API EXTERNA (Vision/Complejo) ---
# Qwen VL (DashScope) para analisis de imagenes de productos
EXTERNAL_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EXTERNAL_API_KEY=sk-tu-clave-dashscope

# OpenAI (opcional, para razonamiento complejo)
OPENAI_API_KEY=sk-tu-clave-openai

# --- TIKTOK LIVE ---
# Obtener de las cookies del navegador despues de loguearte en TikTok
TIKTOK_SESSION_ID=tu_session_id_aqui
TIKTOK_USERNAME=tu_usuario_tiktok

# --- YOUTUBE LIVE ---
# Crear en Google Developer Console -> YouTube Data API v3
YOUTUBE_API_KEY=AIza_tu_api_key_aqui
# ID del video en vivo (se actualiza cada stream)
YOUTUBE_VIDEO_ID=video_id_aqui

# --- WHATSAPP (Evolution API - opcional) ---
# EVOLUTION_API_KEY=tu_clave_evolution
