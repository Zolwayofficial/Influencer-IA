# ============================================================
# INFLUENCER 3D POWERHOUSE - Variables de Entorno
# ============================================================
# Copia este archivo como .env y llena los valores:
#   cp .env.example .env
#   nano .env
# ============================================================

# --- DOMINIO ---
# Tu dominio principal (los servicios se acceden como subdominio.DOMAIN)
DOMAIN=tudominio.com
ACME_EMAIL=tu@email.com

# --- BASE DE DATOS ---
PG_USER=influencer
PG_PASSWORD=CAMBIA_ESTO_password_seguro_123

# --- MINIO (Almacenamiento de Videos) ---
MINIO_ACCESS_KEY=minio_admin
MINIO_SECRET_KEY=CAMBIA_ESTO_minio_secret_456

# --- N8N (Automatizacion) ---
N8N_USER=admin
N8N_PASSWORD=CAMBIA_ESTO_n8n_password_789

# --- GRAFANA ---
GRAFANA_USER=admin
GRAFANA_PASSWORD=CAMBIA_ESTO_grafana_password

# --- TRAEFIK DASHBOARD ---
# Generar con: htpasswd -nB admin
# Formato: usuario:hash_bcrypt
TRAEFIK_DASHBOARD_AUTH=admin:$$2y$$10$$hash_aqui

# ============================================================
# IA: QWEN API (DashScope) - PRINCIPAL
# ============================================================
# Crear cuenta gratis en: https://dashscope.console.aliyun.com
# Cada modelo incluye 1 millon de tokens gratis (90 dias)
#
DASHSCOPE_API_KEY=sk-tu-clave-dashscope

# Modelo LLM para chat (opciones: qwen-turbo, qwen-plus, qwen-max, qwen3-max)
# qwen-plus: buen balance calidad/precio ($0.40/1M input)
# qwen-turbo: mas barato ($0.10/1M input)
LLM_MODEL=qwen-plus
LLM_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Modelo complejo (opcional, por defecto usa qwen-max via DashScope)
# Si prefieres usar OpenAI GPT-4o, descomenta las siguientes lineas:
# COMPLEX_MODEL=gpt-4o
# COMPLEX_API_URL=https://api.openai.com/v1
# COMPLEX_API_KEY=sk-tu-clave-openai

# OpenAI (opcional, solo si quieres usar GPT-4o para razonamiento complejo)
OPENAI_API_KEY=

# --- TIKTOK LIVE ---
# Obtener de las cookies del navegador despues de loguearte en TikTok
TIKTOK_SESSION_ID=tu_session_id_aqui
TIKTOK_USERNAME=tu_usuario_tiktok

# --- YOUTUBE LIVE ---
# Crear en Google Developer Console -> YouTube Data API v3
YOUTUBE_API_KEY=AIza_tu_api_key_aqui
# ID del video en vivo (se actualiza cada stream)
YOUTUBE_VIDEO_ID=video_id_aqui
