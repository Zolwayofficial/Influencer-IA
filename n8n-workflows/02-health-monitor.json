{
  "name": "Monitor de Salud",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "name": "Cada 5 Minutos",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [250, 300]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "name": "Verificar Servicios",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [480, 300]
    },
    {
      "parameters": {
        "jsCode": "const services = [\n  { name: 'Ollama', url: 'http://ollama:11434/api/tags' },\n  { name: 'Qdrant', url: 'http://qdrant:6333/healthz' },\n  { name: 'HeadTTS', url: 'http://headtts:3001/health' },\n  { name: 'Chat Bridge', url: 'http://chat-bridge:4000/health' },\n  { name: 'Compositor', url: 'http://stream-compositor:5000/health' },\n];\n\nconst results = [];\n\nfor (const svc of services) {\n  try {\n    const res = await this.helpers.httpRequest({ url: svc.url, timeout: 5000 });\n    results.push({ name: svc.name, status: 'UP', details: res });\n  } catch (err) {\n    results.push({ name: svc.name, status: 'DOWN', error: err.message });\n  }\n}\n\nconst downServices = results.filter(r => r.status === 'DOWN');\n\nreturn [{ json: { results, downServices, allHealthy: downServices.length === 0 } }];"
      },
      "name": "Check All Services",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.allHealthy }}",
              "value2": false
            }
          ]
        }
      },
      "name": "Algun servicio caido?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [700, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://ntfy.sh/influencer-alerts",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "topic",
              "value": "influencer-alerts"
            },
            {
              "name": "message",
              "value": "={{ 'ALERTA: Servicios caidos: ' + $json.downServices.map(s => s.name).join(', ') }}"
            },
            {
              "name": "title",
              "value": "Influencer 3D - Servicio Caido"
            },
            {
              "name": "priority",
              "value": "high"
            }
          ]
        }
      },
      "name": "Enviar Alerta (ntfy)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [920, 200],
      "notes": "Puedes cambiar ntfy.sh por WhatsApp via Evolution API o Telegram"
    },
    {
      "parameters": {},
      "name": "Todo OK",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [920, 400]
    }
  ],
  "connections": {
    "Cada 5 Minutos": {
      "main": [
        [
          { "node": "Check All Services", "type": "main", "index": 0 }
        ]
      ]
    },
    "Check All Services": {
      "main": [
        [
          { "node": "Algun servicio caido?", "type": "main", "index": 0 }
        ]
      ]
    },
    "Algun servicio caido?": {
      "main": [
        [
          { "node": "Enviar Alerta (ntfy)", "type": "main", "index": 0 }
        ],
        [
          { "node": "Todo OK", "type": "main", "index": 0 }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "America/Mexico_City"
  },
  "tags": [
    { "name": "monitoreo" }
  ]
}
